APP_NAME=Maketo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://192.168.1.8:8000
FRONTEND_URL=http://192.168.1.8:8443

LOG_CHANNEL=stack
LOG_LEVEL=debug

FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail-address@example.com
MAIL_PASSWORD=your-google-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-gmail-address@example.com
MAIL_FROM_NAME="Maketo"
# Optional local fallback:
# MAIL_MAILER=log

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=maketo
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_COOKIE=maketo_dev_session
SESSION_DOMAIN=
QUEUE_CONNECTION=database
CACHE_STORE=database

SANCTUM_STATEFUL_DOMAINS=192.168.1.8:8443,192.168.1.8:8000
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# Keep the session host-only so localhost and LAN-IP development both work.
SESSION_DOMAIN=

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=
R2_REGION=auto
R2_USE_PATH_STYLE_ENDPOINT=true

# Development-only payment sandbox. No real money is transferred.
PAYMENT_PROVIDER=simulated
SIMULATED_PAYMENT_OUTCOME=success
