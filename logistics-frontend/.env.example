# Public Laravel API base URL (browser-safe). Must end with /api.
# Local development:
VITE_API_URL=http://127.0.0.1:8000/api
# Production (set in Cloudflare Workers Builds, not committed):
# VITE_API_URL=https://maketo-api.onrender.com/api
#
# Only browser-safe VITE_* values belong here. Never add backend secrets
# (DB_*, APP_KEY, R2 keys, mail or Resend credentials).
